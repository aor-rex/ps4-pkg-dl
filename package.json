{
  "name": "ps4-pkg-dl",
  "version": "0.1.4",
  "description": "Desktop app for browsing and downloading PS4 packages from the Internet Archive FPKGi catalog",
  "main": "main/index.js",
  "desktopName": "com.ps4pkgdl.app.desktop",
  "bin": {
    "ps4dl": "cli/index.js"
  },
  "scripts": {
    "cli": "node cli/index.js",
    "server": "node server/index.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "app": "electron .",
    "app:dev": "electron . --dev",
    "rebuild": "electron-builder install-app-deps",
    "dist": "electron-builder --linux AppImage --publish never"
  },
  "keywords": [
    "ps4",
    "pkg",
    "downloader",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.15.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^12.0.0",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "node-7z": "^3.0.0",
    "node-downloader-helper": "^2.1.0",
    "node-notifier": "^10.0.1",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "better-sqlite3@12.9.0": true,
    "electron@41.10.7": true
  },
  "devDependencies": {
    "electron": "^41.10.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ps4pkgdl.app",
    "productName": "PS4 PKG Downloader",
    "artifactName": "PS4-PKG-Downloader-${version}.AppImage",
    "publish": {
      "provider": "github",
      "owner": "aor-rex",
      "repo": "ps4-pkg-dl",
      "releaseType": "prerelease"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "package.json",
      "main/**/*",
      "server/**/*",
      "cli/**/*",
      "renderer/dist/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "assets/icon.png",
      "syncDesktopName": true
    }
  }
}
