{
  "name": "ps4-pkg-dl",
  "version": "0.1.0",
  "description": "Desktop app for browsing and downloading PS4 packages from the Internet Archive FPKGi catalog",
  "main": "src/main/index.js",
  "bin": {
    "ps4dl": "src/cli/index.js"
  },
  "scripts": {
    "cli": "node src/cli/index.js",
    "server": "node server/index.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "app": "electron .",
    "app:dev": "electron . --dev"
  },
  "keywords": [
    "ps4",
    "pkg",
    "downloader",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.15.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^12.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "node-7z": "^3.0.0",
    "node-downloader-helper": "^2.1.0",
    "node-notifier": "^10.0.1",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "better-sqlite3@12.9.0": true,
    "electron@41.10.7": true
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^41.10.7"
  },
  "overrides": {
    "yargs": "^18.1.0"
  }
}
